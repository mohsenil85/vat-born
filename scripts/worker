#!/usr/bin/env bash
# Starts a GLM worker on a task spec, the way docs/plan.md ("Running the work") runs them: its own worktree
# (.worktrees/NAME on branch pi/NAME), this repo's AGENTS.md as its only context, high thinking, and a commit
# through the pre-commit hook when it finishes. Prints the worker's report.
# Usage: scripts/worker NAME TASK.md [more pi-worker flags]
set -euo pipefail
[ $# -ge 2 ] || { echo "usage: scripts/worker NAME TASK.md [pi-worker flags]" >&2; exit 2; }
name=$1 task=$2
shift 2
root=$(git rev-parse --show-toplevel)
# CMUX_PI_HOOKS_DISABLED keeps the cmux terminal's pi extension out of headless runs.
CMUX_PI_HOOKS_DISABLED=1 exec pi-worker -C "$root" -b glm -w "$name" --commit --thinking high --no-context \
    --no-skills --append-system-prompt "$root/.worktrees/$name/AGENTS.md" -f "$task" "$@"
